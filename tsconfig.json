{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "types": ["node"]
  },
  "include": [
    "packages/contracts/src",
    "packages/core/src",
    "packages/workers/src",
    "packages/adapter-dummy/src",
    "packages/adapter-claude/src",
    "packages/adapter-codex/src",
    "packages/adapter-opencode/src",
    "packages/adapter-aider/src",
    "packages/adapter-copilot/src",
    "packages/adapter-cursor-clip/src",
    "packages/adapter-claude-clip/src",
    "packages/gateway-mcp/src",
    "packages/adapter-testkit/src",
    "packages/server/src",
    "packages/hubctl/src",
    "packages/*/test",
    "scripts",
    "e2e",
    "vitest.config.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["packages/pwa"]
}
