# deps
node_modules/

# build
dist/
*.tsbuildinfo

# runtime data (sessions, blobs, sqlite) — never commit
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# env & secrets
.env
.env.*
hub.config.json
hub.config.json.bak*
hub.config.local.json
device-tokens.txt

# fixtures may contain recorded streams — reviewed copies are committed explicitly
fixtures/**/*.raw

# coverage & logs
coverage/
*.log

# pwa build output served by server from source in dev
apps/pwa/dist/

# editors
.idea/
.vscode/
*.swp
.DS_Store

# Playwright E2E gate output
playwright-report/
test-results/

# Node --report-on-fatalerror Dumps
report.*.json
