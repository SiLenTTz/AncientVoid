#!/usr/bin/env python3
"""Stand-in für factoryctl `new` im Test: liest das Token wie das echte (getpass), prüft es und legt die Linie an."""
import getpass, os, sys
args = sys.argv[1:]
if args[0] != "new":
    sys.exit("unsupported")
line, repo = args[1], args[args.index("--repo") + 1]
mode = args[args.index("--mode") + 1] if "--mode" in args else "supervised"
token = getpass.getpass("token: ")
if token != "gut":
    print(f"✗ factoryctl: the token cannot see {repo} (HTTP 401) {token}")
    sys.exit(1)
home = os.environ["FACTORY_HOME"]
os.makedirs(f"{home}/lines/{line}", exist_ok=True)
with open(f"{home}/lines/{line}/line.env", "w") as f:
    f.write(f"LINE_NAME={line}\nLINE_REPO={repo}\nLINE_MODE={mode}\nGITHUB_TOKEN={token}\n")
print("✓ line started")
