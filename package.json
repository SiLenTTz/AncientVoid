{
  "name": "mobile-hub",
  "version": "0.1.0",
  "private": true,
  "description": "UACC — Unified AI-Agent Command Center. Local-first, vendor-neutral hub to supervise and steer coding agents from mobile.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p . --noEmit",
    "dev:server": "node --watch packages/server/src/main.ts",
    "gateway-mcp": "node packages/gateway-mcp/src/main.ts",
    "loadtest": "node scripts/loadtest.mjs",
    "messlauf:hubctl-latency": "node scripts/messlauf-hubctl-latency.mjs",
    "messlauf:approve-latency": "node scripts/messlauf-approve-latency.mjs",
    "check:adapter-matrix": "node scripts/check-adapter-matrix.mjs",
    "hubctl": "node packages/hubctl/src/cli.ts",
    "gate": "npm run typecheck && npm run lint && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.14.0",
    "eslint-plugin-n": "^17.14.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
