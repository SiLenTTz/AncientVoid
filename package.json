{
  "name": "mobile-hub",
  "version": "0.1.0",
  "private": true,
  "description": "UACC — Unified AI-Agent Command Center. Local-first, vendor-neutral hub to supervise and steer coding agents from mobile.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p . --noEmit && npm run -s typecheck --workspace apps/pwa",
    "dev:server": "node --watch apps/hub/src/main.ts",
    "gateway-mcp": "node apps/gateway-mcp/src/main.ts",
    "loadtest": "node scripts/loadtest.mjs",
    "messlauf:hubctl-latency": "node scripts/messlauf-hubctl-latency.mjs",
    "messlauf:approve-latency": "node scripts/messlauf-approve-latency.mjs",
    "messlauf:p5-discovery": "node scripts/messlauf-p5.mjs discovery",
    "messlauf:p5-recovery": "node scripts/messlauf-p5.mjs recovery",
    "messlauf:p5-recovery-provider": "node scripts/messlauf-p5.mjs recovery-provider --runs 5",
    "check:adapter-matrix": "node scripts/check-adapter-matrix.mjs",
    "check:commits": "node scripts/check-commits.mjs",
    "check:arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "prepare": "node scripts/setup-git.mjs",
    "hubctl": "node apps/hubctl/src/cli.ts",
    "gate": "npm run typecheck && npm run lint && npm run check:commits && npm run check:arch && npm run check:adapter-matrix && npm test && npm run test:e2e",
    "test:live": "scripts/test-live.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.12.0",
    "eslint-plugin-n": "^18.4.1",
    "playwright": "^1.64.0",
    "typescript": "6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
